import requests
from bs4 import BeautifulSoup
import pandas as pd
import time
import random

# Amazon search URL for PlayStation 5
BASE_URL = "https://www.amazon.in"
SEARCH_QUERY = "playstation+5"
MAX_PAGES = 3  # Change as needed

# Headers to mimic a browser visit
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                  "(KHTML, like Gecko) Chrome/117.0.0.0 Safari/537.36",
    "Accept-Language": "en-US,en;q=0.5"
}

# Function to extract product details from individual product page
def extract_product_details(product_url):
    try:
        product_page = requests.get(product_url, headers=HEADERS, timeout=10)
        product_page.raise_for_status()
        soup = BeautifulSoup(product_page.content, "html.parser")

        title = soup.find("span", {"id": "productTitle"})
        title = title.text.strip() if title else "No title"

        price = soup.find("span", {"class": "a-price-whole"})
        price = price.text.strip().replace(",", "") if price else "No price"

        rating = soup.find("span", {"class": "a-icon-alt"})
        rating = rating.text.strip() if rating else "No rating"

        brand = soup.find("a", {"id": "bylineInfo"})
        brand = brand.text.strip() if brand else "No brand"

        return {
            "Title": title,
            "Price": price,
            "Rating": rating,
            "Brand": brand,
            "URL": product_url
        }

    except Exception as e:
        print(f"Failed to fetch product data from {product_url}: {e}")
        return {
            "Title": "Error",
            "Price": "Error",
            "Rating": "Error",
            "Brand": "Error",
            "URL": product_url
        }

# Main function to scrape multiple pages
def scrape_amazon_products():
    all_products = []
    current_page = 1
    next_page_url = f"{BASE_URL}/s?k={SEARCH_QUERY}"

    while current_page <= MAX_PAGES and next_page_url:
        print(f"\nScraping page {current_page}: {next_page_url}")
        try:
            response = requests.get(next_page_url, headers=HEADERS, timeout=10)
            response.raise_for_status()
        except requests.exceptions.RequestException as e:
            print(f"Error fetching page {current_page}: {e}")
            break

        soup = BeautifulSoup(response.content, "html.parser")

        product_links = soup.find_all(
            "a",
            class_="a-link-normal s-underline-text s-underline-link-text s-link-style a-text-normal"
        )

        print(f"Found {len(product_links)} product links on page {current_page}")

        for link in product_links:
            product_url = BASE_URL + link.get("href")
            product_data = extract_product_details(product_url)
            all_products.append(product_data)

            time.sleep(random.uniform(1.0, 2.5))  # polite delay

        # Find next page link
        next_page = soup.find("a", class_="s-pagination-next")
        if next_page and 'href' in next_page.attrs:
            next_page_url = BASE_URL + next_page['href']
            current_page += 1
            time.sleep(random.uniform(2.0, 4.0))  # delay between pages
        else:
            print("No next page found.")
            break

    return all_products

# Run the scraper and save to CSV
if __name__ == "__main__":
    products = scrape_amazon_products()
    df = pd.DataFrame(products)
    df.to_csv("amazon_playstation5_products.csv", index=False)
    print("\nScraping completed. Data saved to 'amazon_playstation5_products.csv'")
    print(df.head())
